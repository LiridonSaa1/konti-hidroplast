<IfModule mod_rewrite.c>
    RewriteEngine On

    # Typo-friendly brochure URL alias
    RewriteRule ^brouchures/?$ /attached_assets/DE%20-%20Katallogu%20per%20WEB%20-%20PDF.pdf [R=302,L,NE]

    # Block direct access to this specific PDF file
    RewriteCond %{REQUEST_URI} ^/DE%20-%20Katallogu%20per%20WEB%20-%20PDF\.pdf$ [NC,OR]
    RewriteCond %{REQUEST_URI} ^/DE\ -\ Katallogu\ per\ WEB\ -\ PDF\.pdf$ [NC]
    RewriteRule ^ - [F,L]

    # Never rewrite real static-file requests to index.html.
    # If a file is missing, keep 404 (prevents JS/CSS MIME errors).
    RewriteCond %{REQUEST_URI} \.(?:js|mjs|css|map|json|webmanifest|png|jpg|jpeg|gif|svg|ico|webp|avif|woff2?|ttf|eot|pdf|txt|xml|mp4|webm)$ [NC]
    RewriteRule ^ - [L]

    # Do NOT rewrite API to index.html
    RewriteCond %{REQUEST_URI} ^/api/ [NC]
    RewriteRule ^ - [L]

    # SPA fallback for everything else
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    # Only fallback if index.html exists in the current document root.
    # Prevents internal redirect loops on Passenger roots without index.html.
    RewriteCond %{DOCUMENT_ROOT}/index.html -f
RewriteRule . /index.html [L]
</IfModule>
